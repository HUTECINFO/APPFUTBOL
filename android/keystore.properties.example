# Copia este archivo como keystore.properties (NO lo subas a git).
# Genera el keystore una sola vez y guárdalo en un lugar seguro:
#   keytool -genkeypair -v -keystore clubone-upload.jks -alias clubone -keyalg RSA -keysize 2048 -validity 10000
storeFile=clubone-upload.jks
storePassword=CAMBIA_ESTO
keyAlias=clubone
keyPassword=CAMBIA_ESTO
